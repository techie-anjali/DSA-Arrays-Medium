
class Solution {
    static ArrayList<Integer> leaders(int arr[]) {

        int n = arr.length;
        ArrayList<Integer> ans = new ArrayList<>();

        int maxL = arr[n - 1];
        ans.add(arr[n - 1]);

        for (int i = n - 2; i >= 0; i--) {
            if (arr[i] >= maxL) {
                maxL = arr[i];
                ans.add(arr[i]);
            }
        }

        Collections.reverse(ans);
        return ans;
    }
}
