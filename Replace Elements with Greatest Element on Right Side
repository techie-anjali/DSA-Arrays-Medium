optimized  for 1299. Replace Elements with Greatest Element on Right Side

class Solution {
    public int[] replaceElements(int[] arr) {
        
        int n = arr.length;
        int max = arr[n-1];
        arr[n-1] = -1;

        for(int i = n-2; i >= 0; i--){
            int temp = arr[i];
            arr[i] = max;
            
            if(temp > max){
                max = temp;
            }
        }

        return arr;
    }
}

